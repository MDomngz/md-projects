# Dependencies
node_modules/
ai-scripts/node_modules/

# Build output
lib/

# Local environment / API keys
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local snapshots / backups
.snapshot-*.tar.gz

